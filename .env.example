# =============================================================================
# Data Assistant — environment variables
# Copy this file to `.env` and fill in the values for your environment.
# =============================================================================

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# Model overrides for the NL data-transformation MCP agent. The defaults match
# context/MODEL_STRATEGY.md (gpt-5 for complex queries, gpt-5-mini for simple).
# MAIN_MODEL=gpt-5
# MINI_MODEL=gpt-5-mini-2025-08-07

# Chatbot analyzer: use the same simple-vs-complex heuristics as NL Transform
# (see model_routing.select_main_or_mini_tier). Set to 0 to always use MAIN_MODEL.
# CHATBOT_ANALYZER_TIER=1

# PERF_LOG=1 enables [PERF] lines in app.py plus [PERF][LANGFUSE_HINT] router/analyzer
# logs (wall time + token usage when the SDK exposes it) for Langfuse correlation.

# ── Redis backend ────────────────────────────────────────────────────────────
# The store implementation is selected automatically (see use_redis_cloud_kv):
#
#   1) Standard Redis / Redis Cloud (RECOMMENDED for production):
#        Set REDIS_URL=rediss://default:<password>@<host>:<port>/0
#        OR set REDIS_HOST + REDIS_PORT + REDIS_USERNAME + REDIS_PASSWORD.
#        This path uses redis-py with a connection pool — far lower per-request
#        latency than Upstash REST.
#
#   2) Upstash REST (legacy):
#        Set UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN.
#        Used as a fallback when the standard-Redis env vars above are absent.
#
# Pick ONE of the two blocks below, not both.

# --- Option A: Standard Redis / Redis Cloud (preferred) ---------------------
# REDIS_URL=rediss://default:CHANGE_ME@redis-12345.c1.us-east-1-2.ec2.redns.redis-cloud.com:12345/0
# REDIS_HOST=redis-12345.c1.us-east-1-2.ec2.redns.redis-cloud.com
# REDIS_PORT=12345
# REDIS_USERNAME=default
# REDIS_PASSWORD=CHANGE_ME
# REDIS_TLS=true

# --- Option B: Upstash REST (legacy) ----------------------------------------
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=CHANGE_ME

# Session TTL applied to every key (minutes; default 30).
# SESSION_TTL_MINUTES=30

# ── FastAPI / MCP wiring ─────────────────────────────────────────────────────
# Where the Streamlit app and MCP client should reach the FastAPI server.
# FASTAPI_URL=http://127.0.0.1:8000
# MCP_SERVER_URL=http://127.0.0.1:8000/data/mcp

# ── Performance / cache toggles ──────────────────────────────────────────────
# Set PERF_LOG=1 to emit [PERF] timing lines from app.py.
# PERF_LOG=0
# Disable the T-3 transform-result cache by setting MCP_TRANSFORM_CACHE=0.
# MCP_TRANSFORM_CACHE=1
# MCP_TRANSFORM_CACHE_TTL=900           # seconds; default 15 min
# MCP_TOOL_CACHE_PATH=~/.cache/data-assistant/mcp_tools.json
# MCP_TOOL_CACHE_TTL=3600               # seconds; default 1h

# ── Langfuse (optional) ──────────────────────────────────────────────────────
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
